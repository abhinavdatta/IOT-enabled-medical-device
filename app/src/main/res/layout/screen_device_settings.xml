<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <ImageButton android:id="@+id/btnBackDeviceSettings"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_history"
            android:contentDescription="Back" />

        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Device settings" android:textColor="?attr/wbTextPrimary"
            android:textSize="24sp" android:textStyle="bold" android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/tagline_device_settings" android:textColor="?attr/wbTextSecondary"
        android:textSize="13sp" android:layout_marginBottom="16dp" />

    <!-- LOCAL WI-FI card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:padding="14dp" android:layout_marginBottom="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LOCAL WI-FI" android:textColor="?attr/wbTextMuted"
            android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />

        <TextView android:id="@+id/tvDeviceWifiName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="WaterBench-ESP32"
            android:textColor="?attr/wbTextPrimary" android:textSize="20sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="WaterBench2026"
            android:textColor="?attr/wbTextSecondary" android:textSize="12sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="No Internet access is expected on this direct link."
            android:textColor="?attr/wbTextMuted" android:textSize="11sp" />
    </LinearLayout>

    <!-- RENAME NETWORK card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:padding="14dp" android:layout_marginBottom="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RENAME NETWORK" android:textColor="?attr/wbTextMuted"
            android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />

        <EditText android:id="@+id/etWifiName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/input_bg"
            android:padding="12dp" android:hint="WaterBench_02" android:textColorHint="?attr/wbTextMuted"
            android:textColor="?attr/wbTextPrimary" android:textSize="14sp"
            android:inputType="text" android:maxLength="31" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1–31 characters · letters, numbers, -  and _"
            android:textColor="?attr/wbTextSecondary" android:textSize="11sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Only while IDLE, or safely PAUSED with no alarm."
            android:textColor="?attr/wbWarn" android:textSize="11sp" />

        <Button android:id="@+id/btnApplyRename"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginTop="10dp" android:background="@drawable/btn_normal"
            android:text="APPLY RENAME" android:textColor="?attr/wbBg" android:textStyle="bold" />
    </LinearLayout>

    <!-- HARDWARE SAFETY card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:padding="14dp" android:layout_marginBottom="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_check" android:contentDescription="check" />

            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="HARDWARE SAFETY STAYS ACTIVE"
                android:textColor="?attr/wbTextPrimary" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="The ESP32 retains sensor interlocks and pump cutoff if the app disconnects."
            android:textColor="?attr/wbTextSecondary" android:textSize="12sp" />
    </LinearLayout>

    <!-- RENAME OUTPUT card (status messages shown after Apply) -->
    <LinearLayout android:id="@+id/cardRenameStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/card_bg"
        android:padding="14dp" android:visibility="gone" android:layout_marginBottom="20dp">

        <TextView android:id="@+id/tvRenameStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="The ESP32 is restarting its Wi-Fi. Join the new network name in your phone's Wi-Fi settings, then return here and check the connection."
            android:textColor="?attr/wbTextSecondary" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:gravity="center"
        android:text="Water-only supervised bench prototype · Not for medical or human use"
        android:textColor="?attr/wbTextMuted" android:textSize="11sp" />
</LinearLayout>
